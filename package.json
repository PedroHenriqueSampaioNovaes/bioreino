{
  "name": "bioreino",
  "version": "1.0.0",
  "main": "index.js",
  "private": true,
  "scripts": {
    "dev:all": "concurrently \"npm run frontend\" \"npm run backend\" \"npm run stripe\"",
    "frontend": "npm run dev --prefix client",
    "backend": "npm run start --prefix server",
    "stripe": "npm run stripe --prefix server",
    "commit": "cz",
    "postinstall": "npm install --prefix client"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "devDependencies": {
    "concurrently": "^9.2.1",
    "cz-conventional-changelog": "^3.3.0",
    "ts-node": "^10.9.2"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "workspaces": [
    "server",
    "client"
  ]
}
